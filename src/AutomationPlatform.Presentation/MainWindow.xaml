<Window x:Class="AutomationPlatform.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Automation Platform - Core Engine" Height="600" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hàng 0: Thanh công cụ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBox x:Name="UrlTextBox" Width="400" VerticalAlignment="Center" Margin="0,0,10,0" Padding="5" 
                     Text="https://www.coursera.org/" />

            <Button Content="Start (Đi tới)" Click="OnTestClick" Padding="15,10" Margin="0,0,10,0"/>
            <Button Content="Đăng nhập" Click="OnLoginClick" Padding="15,10" />
            <Button x:Name="DiscussionRetryButton" Content="Kiểm tra lại bài thảo luận"
                    Click="OnRetryDiscussionClick" Padding="12,10" Margin="10,0,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Bỏ qua dạng bài:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="SkipPeerPdfCheckBox" Content="Nộp PDF / Peer-graded"
                      VerticalAlignment="Center" Margin="0,0,16,0"
                      ToolTip="Bỏ qua phần bài nộp Peer-graded, bao gồm các bài yêu cầu PDF."/>
            <CheckBox x:Name="SkipPeerReviewCheckBox" Content="Đánh giá chéo (Review peers)"
                      VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Áp dụng bỏ qua" Click="OnApplyActivitySkipsClick" Padding="12,6"/>
            <TextBlock Text="Chọn dạng rồi bấm Áp dụng; bài bỏ qua vẫn chưa hoàn thành trên Coursera."
                       VerticalAlignment="Center" Margin="12,4,0,0" Foreground="#666666" TextWrapping="Wrap"/>
        </WrapPanel>

        <!-- Trạng thái -->
        <Border Grid.Row="2" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1"
                CornerRadius="5" Padding="10,5" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Bold" 
                       Foreground="#856404" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>


        <!-- Hàng 2: Trình duyệt nhúng WebView2 -->
        <wv2:WebView2 Grid.Row="3" Name="MainWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        
        
    </Grid>
</Window>
