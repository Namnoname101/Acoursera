<Window x:Class="AutomationPlatform.AccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACOSE Account Manager"
        Width="1440"
        Height="920"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="22,19"
                Background="{StaticResource HeaderGradientBrush}"
                CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Background="#22FFFFFF"
                        BorderBrush="#38FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="A" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}"
                               Text="ACOSE Account Manager" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#CBD5E1"
                               Text="Quản lý profile Coursera và tiến trình worker trên thiết bị này" />
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="13,8"
                        VerticalAlignment="Center"
                        Background="#20FFFFFF"
                        BorderBrush="#32FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="#4ADE80" />
                        <TextBlock x:Name="OverallStatusText"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="Đang kiểm tra..." />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Summary metrics -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Margin="0,0,8,0"
                    Padding="18,16"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            Margin="0,0,13,0"
                            Background="{StaticResource PrimarySoftBrush}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Text="P" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="PROFILE ĐÃ LƯU" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Sẵn sàng sử dụng" />
                    </StackPanel>
                    <TextBlock x:Name="ProfileCountText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Text="0" />
                </Grid>
            </Border>

            <Border Margin="4,0"
                    Padding="18,16"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            Margin="0,0,13,0"
                            Background="{StaticResource SuccessSoftBrush}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Text="W" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="WORKER ĐANG CHẠY" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Tiến trình hoạt động" />
                    </StackPanel>
                    <TextBlock x:Name="RunningWorkerCountText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="0" />
                </Grid>
            </Border>

            <Border Margin="8,0,0,0"
                    Padding="18,16"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="42"
                            Margin="0,0,13,0"
                            Background="{StaticResource WarningSoftBrush}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="MAX" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="GIỚI HẠN WORKER" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Số khóa đồng thời" />
                    </StackPanel>
                    <TextBlock x:Name="MaxWorkerLimitText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Text="2" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Main workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.62*" MinWidth="620" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Profile list -->
            <Border Grid.Column="0"
                    Padding="20"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="Danh sách profile" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource SupportingText}"
                                       Text="Chọn một profile để xem, chỉnh sửa hoặc điều khiển worker." />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="9,5"
                                VerticalAlignment="Top"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="12">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="NHẤP ĐÚP ĐỂ CHẠY" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelText}" Text="Tìm kiếm" />
                            <Grid>
                                <TextBox x:Name="SearchTextBox"
                                         Padding="37,9,12,9"
                                         ToolTip="Tìm theo tên, loại hoặc profile ID"
                                         TextChanged="SearchTextBox_TextChanged" />
                                <TextBlock Margin="13,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontSize="17"
                                           Foreground="#94A3B8"
                                           Text="⌕" />
                            </Grid>
                        </StackPanel>
                        <Button Grid.Column="2"
                                MinWidth="106"
                                VerticalAlignment="Bottom"
                                Click="RefreshButton_Click"
                                Content="↻  Làm mới"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,0,0,14"
                            Padding="13"
                            Style="{StaticResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelText}" Text="Tạo profile mới" />
                                <TextBox x:Name="NewProfileNameTextBox"
                                         ToolTip="Tên profile mới, ví dụ: Khách A" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    MinWidth="126"
                                    VerticalAlignment="Bottom"
                                    Click="CreateProfileButton_Click"
                                    Content="＋  Tạo profile" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <DataGrid x:Name="ProfilesGrid"
                                  IsReadOnly="True"
                                  MouseDoubleClick="ProfilesGrid_MouseDoubleClick"
                                  SelectionChanged="ProfilesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="TÀI KHOẢN / PROFILE" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="LOẠI" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    Background="#F1F5F9"
                                                    CornerRadius="10">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#475569"
                                                           Text="{Binding KindLabel}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="THAO TÁC" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button MinWidth="54"
                                                        Click="StartWorkerInGrid_Click"
                                                        Content="▶  Chạy"
                                                        IsEnabled="{Binding CanStartWorker}"
                                                        Style="{StaticResource CompactSuccessButton}"
                                                        Tag="{Binding ProfilePath}"
                                                        ToolTip="Khởi chạy worker" />
                                                <Button MinWidth="54"
                                                        Margin="5,0,8,0"
                                                        Click="StopWorkerInGrid_Click"
                                                        Content="■  Dừng"
                                                        IsEnabled="{Binding IsRunning}"
                                                        Style="{StaticResource CompactDangerButton}"
                                                        Tag="{Binding ProfilePath}"
                                                        ToolTip="Dừng worker" />
                                                <TextBlock MaxWidth="65"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding SessionStatus}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SessionStatus}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="DÙNG GẦN NHẤT"
                                                    Width="125"
                                                    Binding="{Binding LastUsedText}" />
                                <DataGridTemplateColumn Header="PROFILE ID" Width="1.25*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding ProfileKey}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ProfileKey}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="12"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ProfilesGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="44"
                                        Height="44"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        CornerRadius="22">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="P" />
                                </Border>
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="Chưa có profile phù hợp" />
                                <TextBlock Margin="0,3,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Tạo profile mới hoặc thử từ khóa khác." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Details and settings -->
            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,14"
                            Padding="19"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="Chi tiết profile" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource SupportingText}"
                                               Text="Thông tin và trạng thái các khóa học." />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Padding="9,5"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        CornerRadius="12">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="PROFILE" />
                                </Border>
                            </Grid>

                            <Border Margin="0,0,0,14"
                                    Padding="11,9"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock x:Name="SelectedProfileHintText"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Chọn một profile ở danh sách bên trái"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabelText}" Text="Tên hiển thị" />
                            <TextBox x:Name="SelectedNameTextBox" IsEnabled="False" />

                            <TextBlock Margin="0,13,0,6"
                                       Style="{StaticResource FieldLabelText}"
                                       Text="Link khóa để làm việc" />
                            <TextBox x:Name="SelectedLinkTextBox"
                                     Height="78"
                                     AcceptsReturn="True"
                                     IsEnabled="False"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Mỗi link một dòng · chỉ chấp nhận HTTPS thuộc coursera.org"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,15,0,0">
                                <Button x:Name="SaveProfileButton"
                                        Margin="0,0,7,7"
                                        Click="SaveProfileButton_Click"
                                        Content="Lưu thay đổi"
                                        IsEnabled="False" />
                                <Button x:Name="StartProfileButton"
                                        Margin="0,0,7,7"
                                        Click="StartProfileButton_Click"
                                        Content="▶  Chạy tất cả"
                                        IsEnabled="False"
                                        Style="{StaticResource SuccessButton}" />
                                <Button x:Name="StopProfileButton"
                                        Margin="0,0,7,7"
                                        Click="StopProfileButton_Click"
                                        Content="■  Dừng tất cả"
                                        IsEnabled="False"
                                        Style="{StaticResource DangerButton}" />
                                <Button x:Name="OpenFolderButton"
                                        Margin="0,0,0,7"
                                        Click="OpenFolderButton_Click"
                                        Content="Mở thư mục"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButton}" />
                            </WrapPanel>

                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="TRẠNG THÁI CÁC KHÓA HỌC" />
                                <TextBlock Grid.Column="1"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="THEO TỪNG LINK" />
                            </Grid>

                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <Grid MinHeight="74">
                                    <ListView x:Name="ProfileLinksListView"
                                              MaxHeight="235"
                                              BorderThickness="0"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   Text="{Binding Url}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Url}" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusColor}"
                                                                   Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                        <Button MinWidth="50"
                                                                Click="StartSingleLink_Click"
                                                                Content="▶ Chạy"
                                                                IsEnabled="{Binding CanStart}"
                                                                Style="{StaticResource CompactSuccessButton}"
                                                                Tag="{Binding Url}"
                                                                ToolTip="Chạy khóa này" />
                                                        <Button MinWidth="50"
                                                                Margin="5,0,0,0"
                                                                Click="StopSingleLink_Click"
                                                                Content="■ Dừng"
                                                                IsEnabled="{Binding CanStop}"
                                                                Style="{StaticResource CompactDangerButton}"
                                                                Tag="{Binding Url}"
                                                                ToolTip="Dừng khóa này" />
                                                        <Button MinWidth="42"
                                                                Margin="5,0,0,0"
                                                                Click="EditSingleLink_Click"
                                                                Content="Sửa"
                                                                IsEnabled="{Binding CanModify}"
                                                                Style="{StaticResource CompactSecondaryButton}"
                                                                Tag="{Binding Url}"
                                                                ToolTip="Sửa link khóa này" />
                                                        <Button MinWidth="42"
                                                                Margin="5,0,0,0"
                                                                Click="DeleteSingleLink_Click"
                                                                Content="Xóa"
                                                                IsEnabled="{Binding CanModify}"
                                                                Style="{StaticResource CompactDangerButton}"
                                                                Tag="{Binding Url}"
                                                                ToolTip="Xóa link khóa này" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"
                                               IsHitTestVisible="False"
                                               Text="Chọn profile để xem các khóa học.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ProfileLinksListView}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Padding="19" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="Cấu hình worker" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource SupportingText}"
                                               Text="Thiết lập đường dẫn và giới hạn chạy." />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="34"
                                        Height="34"
                                        VerticalAlignment="Top"
                                        Background="#F1F5F9"
                                        CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="#475569"
                                               Text="⚙" />
                                </Border>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabelText}" Text="Server URL" />
                            <TextBox x:Name="ServerUrlTextBox" />

                            <TextBlock Margin="0,12,0,6"
                                       Style="{StaticResource FieldLabelText}"
                                       Text="Worker executable" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WorkerExecutableTextBox" />
                                <Button Grid.Column="2"
                                        MinWidth="44"
                                        Click="BrowseWorkerButton_Click"
                                        Content="…"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Chọn tệp worker" />
                            </Grid>

                            <TextBlock Margin="0,12,0,6"
                                       Style="{StaticResource FieldLabelText}"
                                       Text="Thư mục profile" />
                            <TextBox x:Name="ProfileRootTextBox" />

                            <TextBlock Margin="0,12,0,6"
                                       Style="{StaticResource FieldLabelText}"
                                       Text="Số khóa chạy đồng thời" />
                            <TextBox x:Name="MaxWorkersTextBox" />

                            <Button Margin="0,15,0,0"
                                    HorizontalAlignment="Left"
                                    Click="SaveHostSettingsButton_Click"
                                    Content="Lưu cấu hình" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer status -->
        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12,9"
                Background="#E8FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7"
                         Height="7"
                         Margin="2,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource PrimaryBrush}" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="Sẵn sàng."
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProfileRootSummaryText"
                           Grid.Column="2"
                           MaxWidth="520"
                           Margin="12,0,2,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </Grid>
        </Border>
    </Grid>
</Window>
